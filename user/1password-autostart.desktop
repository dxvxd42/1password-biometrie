[Desktop Entry]
Type=Application
Name=1Password (im Hintergrund)
Comment=Startet 1Password bei der Anmeldung unsichtbar im Systembereich, damit das Passwort nur einmal pro Hochfahren nötig ist
Exec=__HOME__/.local/bin/1password-biometrie --start --silent
Icon=1password
Terminal=false
X-GNOME-Autostart-enabled=true
X-KDE-autostart-phase=2

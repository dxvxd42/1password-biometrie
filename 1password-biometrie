#!/usr/bin/env bash
# Benutzerteil: prüft und repariert 1Password-Entsperren per Gesicht/Fingerabdruck.
#   ohne Argument   prüfen + reparieren (systemd-User-Dienst: bei Anmeldung, 1Password-Update,
#                   Änderung der 1Password-Einstellungen)
#   --pruefen       nur prüfen, Ergebnis im Terminal (Exit 0 = alles gut)
#   --start [ARGS]  vom Startmenü-Eintrag: erst reparieren, dann 1Password starten
set -uo pipefail

OP=/opt/1Password/1password
NATIVE=/opt/1Password/resources/app.asar.unpacked/index.node
SETTINGS=$HOME/.config/1Password/settings/settings.json
SCHLUESSEL=security.authenticatedUnlock.automatic
PAM=/etc/pam.d/polkit-1
POLICY=/usr/share/polkit-1/actions/com.1password.1Password.policy
SYS_DESKTOP=/usr/share/applications/com.onepassword.OnePassword.desktop
MEIN_DESKTOP=$HOME/.local/share/applications/com.onepassword.OnePassword.desktop
CACHE=${XDG_CACHE_HOME:-$HOME/.cache}/1password-biometrie
SELBST=$(readlink -f "$0")
modus=${1:-}

log() { [[ -t 1 ]] && echo "$*"; logger -t 1password-biometrie -- "$*" 2>/dev/null || true; }
laeuft() { pgrep -u "$UID" -x 1password >/dev/null; }

melden() {  # $1 Dringlichkeit, $2 Titel, $3 Text, [$4 Aktion "name=Text", $5 Befehl bei Klick]
  [[ $modus == --pruefen ]] && return 0
  if [[ -n ${4:-} ]]; then
    # eigene kurzlebige Unit, damit das Warten auf den Klick den Dienst nicht blockiert
    systemd-run --user --quiet --collect --no-block -- bash -c \
      'a=$(notify-send -a "1Password-Entsperren" -i 1password -u "$1" -A "$4" "$2" "$3"); [[ -n $a ]] && eval "$5"' \
      _ "$1" "$2" "$3" "$4" "$5" 2>/dev/null && return 0
  fi
  notify-send -a "1Password-Entsperren" -i 1password -u "$1" "$2" "$3" 2>/dev/null || true
}

einstellung() {  # gibt Wert einer Einstellung aus (true/false/fehlt)
  python3 -I -c '
import json,sys
try: d=json.load(open(sys.argv[1]))
except Exception: print("kaputt"); sys.exit()
v=d.get(sys.argv[2]); print("fehlt" if v is None else str(v).lower())' "$SETTINGS" "$1"
}

schluessel_setzen() {  # atomar schreiben, authTags bleibt am Ende
  python3 -I -c '
import json,os,sys
p,k=sys.argv[1],sys.argv[2]
d=json.load(open(p))
tags=d.pop("authTags",None)
d[k]=True
if tags is not None: d["authTags"]=tags
t=p+".tmp-biometrie"
with open(t,"w") as f: json.dump(d,f,indent=2)
os.chmod(t,os.stat(p).st_mode & 0o777)
os.replace(t,p)' "$SETTINGS" "$SCHLUESSEL"
}

startmenue_eintrag() {  # eigener Startmenü-Eintrag, der vor dem Start repariert
  [[ -f $SYS_DESKTOP ]] || return 0
  local neu
  neu=$(sed -E "s|^Exec=[^ ]+|Exec=$SELBST --start|" "$SYS_DESKTOP")
  if [[ ! -f $MEIN_DESKTOP || $(cat "$MEIN_DESKTOP") != "$neu" ]]; then
    mkdir -p "${MEIN_DESKTOP%/*}"; printf '%s\n' "$neu" > "$MEIN_DESKTOP"
    log "Startmenü-Eintrag aktualisiert"
  fi
}

probleme=(); hinweise=()

# 1) Kennt 1Password die versteckte Einstellung noch?
unterstuetzt=1
if [[ -f $NATIVE ]] && ! grep -qaF "$SCHLUESSEL" "$NATIVE"; then
  unterstuetzt=0
  probleme+=("1Password kennt „$SCHLUESSEL“ nicht mehr (nach Update umbenannt?) – Abfrage kommt evtl. nicht mehr von selbst")
fi

# 2) Einstellungen
if [[ -f $SETTINGS ]]; then
  case $(einstellung security.authenticatedUnlock.enabled) in
    true) ;;
    kaputt) probleme+=("settings.json nicht lesbar") ;;
    *) probleme+=("In 1Password ist „Mit Systemauthentifizierung entsperren“ aus → Einstellungen › Sicherheit einschalten") ;;
  esac
  wert=$(einstellung "$SCHLUESSEL")
  if [[ $wert != true && $wert != kaputt && $unterstuetzt == 1 ]]; then
    if [[ $modus == --pruefen ]]; then
      probleme+=("Automatische Abfrage ist aus (Einstellung fehlt)")
    elif laeuft; then
      probleme+=("Automatische Abfrage ist aus – wird beim nächsten Start von 1Password repariert")
      neustart=1
    elif schluessel_setzen; then
      log "repariert: automatische Abfrage wieder eingetragen"
      hinweise+=("Automatische Fingerabdruck-/Gesichtsabfrage wieder eingeschaltet")
    else
      probleme+=("Automatische Abfrage konnte nicht eingetragen werden")
    fi
  fi
fi

# 3) Systemteil (nur prüfen – repariert wird vom Root-Dienst)
pam_ok() {
  awk '/^[[:space:]]*#/{next}
    $1=="auth"&&$2=="sufficient"&&$3=="pam_howdy.so"{h=NR}
    $1=="auth"&&$2=="sufficient"&&$3=="pam_fprintd.so"{f=NR}
    $1=="auth"&&$2=="include"&&$3=="system-auth"{s=NR}
    END{exit !(h&&f&&s&&h<s&&f<s)}' "$PAM" 2>/dev/null
}
sys_kaputt=0
pam_ok || { probleme+=("$PAM ohne Gesicht/Fingerabdruck"); sys_kaputt=1; }
grep -q com.1password.1Password.unlock "$POLICY" 2>/dev/null || { probleme+=("polkit-Regel von 1Password fehlt"); sys_kaputt=1; }
for m in pam_howdy.so pam_fprintd.so; do
  [[ -f /usr/lib/security/$m ]] || probleme+=("$m fehlt")
done

# 4) Fingerabdruck noch eingelernt? (nicht beim Programmstart, dauert kurz)
if [[ $modus != --start ]] && command -v fprintd-list >/dev/null; then
  fprintd-list "$USER" 2>/dev/null | grep -q ' - #' || probleme+=("Kein Fingerabdruck eingelernt (fprintd-enroll)")
fi

[[ $modus != --pruefen ]] && startmenue_eintrag

# ---------- Ergebnis ----------
if [[ $modus == --pruefen ]]; then
  if [[ ${#probleme[@]} -eq 0 ]]; then echo "1Password-Entsperren: alles in Ordnung."; else
    echo "1Password-Entsperren: Probleme:"; printf '  - %s\n' "${probleme[@]}"; fi
  [[ -x /usr/local/sbin/1password-biometrie-system ]] || echo "  (Systemteil nicht installiert)"
  [[ ${#probleme[@]} -eq 0 ]]; exit
fi

[[ ${#hinweise[@]} -gt 0 ]] && melden normal "1Password-Entsperren repariert" "$(printf '%s\n' "${hinweise[@]}")"

mkdir -p "$CACHE"
if [[ ${#probleme[@]} -eq 0 ]]; then
  rm -f "$CACHE/gemeldet"
  [[ ${#hinweise[@]} -eq 0 ]] && log "alles in Ordnung"
else
  printf '%s\n' "${probleme[@]}" | while read -r p; do log "Problem: $p"; done
  stand=$(printf '%s\n' "${probleme[@]}")
  if [[ $modus != --start && $(cat "$CACHE/gemeldet" 2>/dev/null) != "$stand" ]]; then
    printf '%s' "$stand" > "$CACHE/gemeldet"   # dieselben Probleme nur einmal melden
    if [[ $sys_kaputt == 1 ]]; then
      melden critical "1Password-Entsperren: Problem" "$stand" "fix=Jetzt reparieren" \
        "pkexec /usr/local/sbin/1password-biometrie-system"
    elif [[ ${neustart:-0} == 1 ]]; then
      melden normal "1Password-Entsperren" "$stand" "neu=1Password jetzt neu starten" \
        "pkill -u $UID -x 1password; sleep 3; setsid $SELBST --start >/dev/null 2>&1 &"
    else
      melden critical "1Password-Entsperren: Problem" "$stand"
    fi
  fi
fi

if [[ $modus == --start ]]; then shift; exec "$OP" "$@"; fi
exit 0

#!/usr/bin/env bash
# Systemteil (läuft als root): prüft und repariert alles, was 1Password-Entsperren
# per Gesicht/Fingerabdruck auf Systemebene braucht.
#   - /etc/pam.d/polkit-1  (Howdy + Fingerabdruck vor dem Passwort)
#   - polkit-Regel von 1Password (/usr/share/polkit-1/actions/...)
#   - PAM-Module pam_howdy.so / pam_fprintd.so vorhanden
# Aufruf: ohne Argument = prüfen + reparieren, --pruefen = nur prüfen.
# Ausgelöst von: pacman-Hook (nach jedem Update) und systemd-Pfad-Unit (1Password-Update in /opt).
set -uo pipefail

BENUTZER=__BENUTZER__
VORLAGE=/usr/local/share/1password-biometrie/polkit-1
PAM=/etc/pam.d/polkit-1
POLICY=/usr/share/polkit-1/actions/com.1password.1Password.policy
OP_DIR=/opt/1Password

log() { logger -t 1password-biometrie -- "$*"; echo "$*"; }

melden() {  # $1 Dringlichkeit, $2 Titel, $3 Text
  local uid; uid=$(id -u "$BENUTZER" 2>/dev/null) || return 0
  [[ -S /run/user/$uid/bus ]] || return 0
  runuser -u "$BENUTZER" -- env DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$uid/bus" \
    notify-send -a "1Password-Entsperren" -i 1password -u "$1" "$2" "$3" 2>/dev/null || true
}

pam_ok() {  # Howdy und Fingerabdruck müssen als "sufficient" VOR system-auth stehen
  [[ -f $PAM ]] || return 1
  awk '
    /^[[:space:]]*#/ {next}
    $1=="auth" && $2=="sufficient" && $3=="pam_howdy.so"   {h=NR}
    $1=="auth" && $2=="sufficient" && $3=="pam_fprintd.so" {f=NR}
    $1=="auth" && $2=="include"    && $3=="system-auth"    {s=NR}
    END { exit !(h && f && s && h<s && f<s) }' "$PAM"
}

probleme=(); repariert=(); offen=()

# 1) PAM-Datei
if ! pam_ok; then
  probleme+=("$PAM ohne Gesicht/Fingerabdruck")
  if [[ ${1:-} != --pruefen && -f $VORLAGE ]]; then
    [[ -f $PAM ]] && cp -a "$PAM" "$PAM.bak-$(date +%Y%m%d-%H%M%S)"
    install -m 644 -o root -g root "$VORLAGE" "$PAM" && pam_ok \
      && repariert+=("$PAM wiederhergestellt") || offen+=("$PAM konnte nicht wiederhergestellt werden")
  else
    offen+=("$PAM fehlerhaft")
  fi
fi

# 2) polkit-Regel von 1Password (ohne sie gibt es gar keine Systemauthentifizierung)
if [[ -d $OP_DIR ]] && ! grep -q 'com.1password.1Password.unlock' "$POLICY" 2>/dev/null; then
  probleme+=("polkit-Regel von 1Password fehlt")
  if [[ ${1:-} != --pruefen && -x $OP_DIR/install_biometrics_policy.sh ]]; then
    ( cd "$OP_DIR" && ./install_biometrics_policy.sh -f ) >/dev/null 2>&1
    grep -q 'com.1password.1Password.unlock' "$POLICY" 2>/dev/null \
      && repariert+=("polkit-Regel neu installiert") || offen+=("polkit-Regel konnte nicht installiert werden")
  else
    offen+=("polkit-Regel fehlt")
  fi
fi

# 3) PAM-Module (Howdy repariert sich über gesicht-reparatur selbst, hier nur melden)
for m in pam_howdy.so pam_fprintd.so; do
  [[ -f /usr/lib/security/$m ]] || { probleme+=("$m fehlt"); offen+=("$m fehlt (Paket neu installieren)"); }
done

if [[ ${1:-} == --pruefen ]]; then
  if [[ ${#probleme[@]} -eq 0 ]]; then echo "System: alles in Ordnung."; exit 0; fi
  printf 'System: Problem: %s\n' "${probleme[@]}"; exit 1
fi

for r in "${repariert[@]}"; do log "repariert: $r"; done
for o in "${offen[@]}";     do log "NICHT behoben: $o"; done
[[ ${#repariert[@]} -gt 0 ]] && melden normal "1Password-Entsperren repariert" "$(printf '%s\n' "${repariert[@]}")"
[[ ${#offen[@]} -gt 0 ]]     && melden critical "1Password-Entsperren: Problem" "$(printf '%s\n' "${offen[@]}")"
[[ ${#probleme[@]} -eq 0 ]] && log "System: alles in Ordnung."
[[ ${#offen[@]} -eq 0 ]]
